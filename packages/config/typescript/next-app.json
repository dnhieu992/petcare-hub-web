{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "PetCare Next.js app",
  "extends": "./base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "plugins": [{ "name": "next" }],
    "noEmit": true,
    "allowJs": true,
    "incremental": true
  }
}
